rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'edgarngene@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Products collection: Public reads, Admin writes
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true; // Demo & admin operations allowed
    }

    // Blog / Journal Posts: Public reads, Admin writes
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true; // Demo & admin operations allowed
    }

    // Customer Orders: Anyone can create; anyone can query by ID; staff can update
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Bespoke Cake Inquiries: Anyone can submit; staff can read/manage
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
